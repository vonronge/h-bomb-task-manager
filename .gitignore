# =============================================================================
# H-Bomb Task Manager — .gitignore
#
# Tracked (required to build & run):
#   pyproject.toml          package metadata and dependencies
#   README.md               install / run instructions
#   hbomb/**/*.py           application source
#   native/Cargo.toml       Rust extension manifest
#   native/Cargo.lock       pinned Rust deps (reproducible native build)
#   native/src/             Rust extension source
#   resources/hbomb.desktop   optional desktop launcher
# =============================================================================

# --- Local virtual environment & package installs ---
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
*.egg

# --- Python bytecode & caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.ruff_cache/
.dmypy.json
.pytype/

# --- Test tooling (not needed to run the app) ---
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --- Dev / UI reference assets (not needed to run) ---
scripts/
reference/
/tmp/hbomb-ui/

# --- Local tooling & runtime scratch ---
.python-version
uv.lock
*.local
*.bak
*.tmp
*.orig

# --- Screenshot / capture output ---
*.png
!resources/**/*.png

# --- Compiled native extension (built by maturin on install) ---
hbomb/_native*
*.so
*.pyd
*.dylib
*.dll

# --- Rust build output ---
native/target/
target/

# --- Maturin / Rust-Python build scratch ---
.maturin/
Cargo.lock.bak

# --- Editor & IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Cursor / agent workspace (local only) ---
.cursor/

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Secrets & local env (never commit) ---
.env
.env.*
*.pem
*.key
credentials.json

# --- Logs & temp output ---
*.log
logs/
tmp/
